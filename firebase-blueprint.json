{
  "entities": {
    "AnalyticsEvent": {
      "title": "AnalyticsEvent",
      "description": "Immutable user interaction event capturing screen views and button clicks without PII to measure course and program interest.",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Anonymous browser session identifier."
        },
        "eventType": {
          "type": "string",
          "enum": [
            "screen_view",
            "button_click",
            "modal_open",
            "modal_close",
            "tab_select",
            "slide_change",
            "form_submit",
            "outbound_click"
          ],
          "maxLength": 32,
          "description": "Category of interaction event."
        },
        "eventName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "description": "Canonical machine-readable event identifier."
        },
        "screen": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Active application route path."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "Human-readable button, link, or screen label."
        },
        "interestCategory": {
          "type": "string",
          "enum": [
            "kids_program",
            "womens_program",
            "teacher_track",
            "trial_booking",
            "certificates",
            "stories",
            "general_info",
            "contact"
          ],
          "maxLength": 32,
          "description": "Inferred visitor interest segment."
        },
        "course": {
          "type": "string",
          "maxLength": 140,
          "description": "Optional program or age-group tier associated with the action."
        },
        "metadata": {
          "type": "string",
          "maxLength": 200,
          "description": "Optional non-PII interaction context."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the event was recorded."
        }
      },
      "required": [
        "sessionId",
        "eventType",
        "eventName",
        "screen",
        "label",
        "interestCategory",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/events/{eventId}": {
      "schema": {
        "$ref": "#/entities/AnalyticsEvent"
      },
      "description": "Append-only stream of screen view and button click analytics events. Publicly writable with strict schema validation; readable only by verified admin."
    }
  }
}
